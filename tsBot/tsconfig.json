{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Environment Settings
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": ["screeps", "node"],

    // Other Outputs
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    // Legacy-Dekoratoren für `@profile` aus `src/profiler/decorator.ts`.
    // Ohne das Flag nimmt TypeScript bei `target: es2022` die Standard-
    // Dekoratoren, deren Signatur nicht zu `(target, key, descriptor)` passt.
    // esbuild liest das Flag aus dieser Datei.
    "experimentalDecorators": true,

    // Recommended Options
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "ts-node": {
    "esm": true,
    "transpileOnly": true,
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext"
    }
  }
}
