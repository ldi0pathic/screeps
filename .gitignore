# Abhängigkeiten (werden mit `pnpm install` in tsBot/ erzeugt)
node_modules/

# Zugangsdaten und lokale Serverkonfiguration
# Vorlagen liegen als *.example im Repo und bleiben versioniert.
.env
.env.local
tsBot/.screeps.json

# Build-Artefakte
# Hinweis: tsProd/main.js bleibt bewusst versioniert – das ist der im Spiel
# laufende Stand. Alles andere aus einem Buildlauf gehört nicht ins Repo.
*.tsbuildinfo

# Sicherungskopien, die build-common.ts::backupMainJs() vor jedem Build von der
# alten tsProd/main.js anlegt. Bewusst ein Schwesterordner und nicht tsProd/
# selbst: uploader.ts lädt jede .js aus tsProd als eigenes Spielmodul hoch.
# Git ist das Archiv der committeten Stände – diese Kopien fangen genau die,
# die nicht committet waren, und gehören deshalb nicht ins Repo.
tsProd-backup/
tsBot/src/**/*.js
tsBot/src/**/*.js.map
tsBot/src/**/*.d.ts
!tsBot/src/types/*.d.ts

# Editor und Betriebssystem
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
