# Abhängigkeiten (werden mit `pnpm install` in tsBot/ erzeugt)
node_modules/

# Zugangsdaten und lokale Serverkonfiguration
# Vorlagen liegen als *.example im Repo und bleiben versioniert.
.env
.env.local
tsBot/.screeps.json

# Build-Artefakte
# Hinweis: tsProd/main.js bleibt bewusst versioniert – das ist der im Spiel
# laufende Stand. Alles andere aus einem Buildlauf gehört nicht ins Repo.
*.tsbuildinfo

# Gebündelte Unittests aus `pnpm test` (Quelle ist tsBot/tests/)
tsBot/.test-build/

# Arbeitsverzeichnis der Subagenten-Abwicklung (Ledger, Auftraege, Reviewpakete).
# Reine Notizen zum Ablauf einer Aenderung; das Ergebnis steht im Commit.
.superpowers/

# Hinweis: tsProd-backup/ ist bewusst NICHT ignoriert. Die Sicherungen, die
# build-common.ts::backupMainJs() vor jedem Build anlegt, gehören mit ins Repo.
# Sie liegen als Schwesterordner und nicht in tsProd/ selbst, weil uploader.ts
# jede .js aus tsProd als eigenes Spielmodul hochladen würde.
tsBot/src/**/*.js
tsBot/src/**/*.js.map
tsBot/src/**/*.d.ts
!tsBot/src/types/*.d.ts

# Editor und Betriebssystem
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
